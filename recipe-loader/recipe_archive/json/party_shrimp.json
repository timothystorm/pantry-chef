  "instructions": [
    {
      "phase": "Marinating",
      "steps": [
        "In a bowl or shallow dish, combine the first eight ingredients (olive oil, honey, lemon juice, garlic, paprika, italian seasoning, dried basil, and black pepper).",
        "Add shrimp and toss to coat.",
        "Refrigerate for 2 hours."
      ]
    },
    {
      "phase": "Cooking Shrimp",
      "steps": [
        "Cook shrimp in the marinade until fully cooked.",
        "Remove shrimp and set aside."
      ]
    },
    {
      "phase": "Sauce and Assembly",
      "steps": [
        "Add coconut flour to the remaining marinade.",
        "Cook on high, whisking vigorously to prevent burning or sticking.",
        "Cook until sauce begins to thicken, about 8 minutes.",
        "Place 6 to 8 shrimp on a bed of rice and drizzle the sauce over the rice and shrimp."
      ]
    }

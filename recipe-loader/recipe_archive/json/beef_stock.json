  "instructions": [
    {
      "phase": "Roasting",
      "steps": [
        "Preheat oven to 450 degrees",
        "Quarter the onion. Scrub carrots and chop into 1 inch chunks. In a large shallow roasting pan add soup bones, onion, and carrots. Bake uncovered for 30 minutes, turning occasionally until bones are well browned."
      ]
    },
    {
      "phase": "Combining",
      "steps": [
        "Drain off fat. Place the bones, onion, and carrots in a large pot. Pour 1/2 cup of water into roasting pan to rinse and pour liquid into pot.",
        "Scrub potato and cut into chunks. Chop celery into thirds. Add remaining ingredients to pot."
      ]
    },
    {
      "phase": "Simmering & Straining",
      "steps": [
        "Bring mixture to a boil then reduce the heat. Cover and simmer for 5 hours.",
        "Drain stock and discard ingredients."
      ]
    }
  ]

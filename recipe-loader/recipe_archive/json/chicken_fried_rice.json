  "instructions": [
    {
      "phase": "Rice Preparation",
      "steps": [
        "Add water to rice in a sauce pan and turn to high heat until rolling boil then turn heat to low, put a lid on and cook for about 15 minutes."
      ]
    },
    {
      "phase": "Prep Work",
      "steps": [
        "While rice is cooking, finely dice the carrots, celery, onion, and mushrooms.",
        "Mince garlic and add to the diced vegetables.",
        "Thinly slice the chicken breasts."
      ]
    },
    {
      "phase": "Cooking Chicken",
      "steps": [
        "Add about 3 Tbsp. cooking oil to a large pan or wok set on high heat.",
        "The instant the oil starts to smoke, add the chicken, stir-frying until the chicken is cooked.",
        "Add sherry, 2 Tbsp. soy sauce, and honey.",
        "Cook chicken for another minute, mixing the sauce, then set it to the side."
      ]
    },
    {
      "phase": "Cooking Vegetables and Eggs",
      "steps": [
        "Add 2 Tbsp. cooking oil to the pan.",
        "The instant it starts to smoke, add the vegetables and garlic, stir-frying for about 2 minutes until the vegetables are cooked but still a bit crunchy.",
        "Pour the whisked eggs over the vegetables and cook omelette style."
      ]
    },
    {
      "phase": "Combining and Finishing",
      "steps": [
        "Once the egg begins to set up, stir them in and add the chicken and cooked rice.",
        "Add 4 Tbsp. soy sauce, 1 cup peas, and the green onions.",
        "Mix everything completely together.",
        "Add salt and pepper to taste.",
        "Serve and enjoy."
      ]
    }
  ]
